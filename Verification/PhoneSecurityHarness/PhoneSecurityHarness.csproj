<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile the shipped sources, rather than copies, so this check cannot drift. -->
    <Compile Include="../../Assets/PhoneControllerAuthService.cs" Link="Product/PhoneControllerAuthService.cs" />
    <Compile Include="../../Assets/PhoneWebController.cs" Link="Product/PhoneWebController.cs" />
    <Compile Include="../../Assets/PhoneWebPageBuilder.cs" Link="Product/PhoneWebPageBuilder.cs" />
  </ItemGroup>
</Project>
